# Copy this file to .env.local and fill in values from the Supabase dashboard.
# Ask Guy for the shared values. Never commit .env.local.

# Supabase: Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth: exact app origin (no path). See docs/ENVIRONMENT.md for all auth settings.
APP_ORIGIN=http://localhost:3000
# Auth rate limiting: required in production, optional locally. Token is a secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Production only: header your reverse proxy overwrites with one client IP.
AUTH_TRUSTED_IP_HEADER=
# Server-only secret key for username lookups (never NEXT_PUBLIC_). Required.
SUPABASE_SECRET_KEY=

# Database: "Connect" button → Transaction pooler (6543) / Session pooler (5432)
DATABASE_URL=
DIRECT_URL=